{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.ts"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "paths": {
      "#build/ui": [
        "./node_modules/.nuxt-ui/ui"
      ]
    },
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
